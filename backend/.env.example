# ---- Core ----
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Email (leave SMTP_HOST empty to save emails as HTML files in backend/outbox/) ----
# Gmail example: create an "App password" (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=SkyLink <yourname@gmail.com>

# ---- Fare watcher ----
FARE_WATCHER=true
FARE_TICK_SECONDS=300
DEV_TOOLS=true

# ---- Payments (sandbox only, no real money) ----
SANDBOX_PAYMENTS=true
SEAT_HOLD_MINUTES=10
